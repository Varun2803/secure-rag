APP_NAME=SecureRAG
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# Production must list exact public hostnames; do not use '*'.
TRUSTED_HOSTS=localhost,127.0.0.1
# Optional; set only to the actual reverse-proxy source network(s).
TRUSTED_PROXY_CIDRS=

POSTGRES_DB=securerag
POSTGRES_USER=securerag
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=
POSTGRES_PORT=5432

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Docker backend service URL; use an HTTPS endpoint for production deployments.
QDRANT_CONTAINER_URL=http://qdrant:6333

DOCUMENT_STORAGE_PATH=./var/documents
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=500
MAX_FILENAME_LENGTH=255
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CHUNK_SIZE=800
EMBEDDING_CHUNK_OVERLAP=120
QDRANT_COLLECTION_NAME=securerag_chunks
QDRANT_PORT=6333

# Optional OpenAI-compatible chat completions provider; leave key blank until configured.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=30
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_ANSWER_TOKENS=800

SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=securerag
JWT_AUDIENCE=securerag-api
BACKEND_PORT=8000

# Local Compose runtime guardrails (development defaults, not capacity guarantees).
BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=4g
BACKEND_PIDS_LIMIT=256
BACKEND_WORKERS=1
BACKEND_UVICORN_GRACEFUL_SHUTDOWN_TIMEOUT=30
BACKEND_STOP_GRACE_PERIOD=45s
BACKEND_TMPFS_SIZE=256m
