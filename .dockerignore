# Start with an empty build context, then admit only the runtime inputs used by
# backend/Dockerfile. New repository files are excluded until deliberately added.
**
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/**
!backend/alembic/
!backend/alembic/**
!alembic.ini

# Re-exclude generated or sensitive paths even if they appear below an admitted
# runtime directory.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/tests/
**/test_*.py
**/*.tmp
**/*.temp
**/*.log
**/*.bak
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/credentials*
**/secrets*
**/.env
**/.env.*
